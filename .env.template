# Strava API credentials.
# From https://www.strava.com/settings/api  (My API Application)
#
# Website:                       http://localhost:8090   (not validated)
# Authorization Callback Domain: localhost               (bare domain, no scheme/port/path)

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional shortcut. Leave blank to use the browser "Connect Strava" flow, which is the
# better option because it grants read_all (needed to see routes you haven't made public).
# If you'd rather skip the browser step, paste the refresh token from the settings page
# here and the app will bootstrap from it on first use. Note that the token shown there
# usually carries only "read" scope, so private routes won't be listed.
STRAVA_REFRESH_TOKEN=

# Only change these if you move the app off localhost:8090.
STRAVA_REDIRECT_URI=http://localhost:8090/api/strava/callback
APP_URL=http://localhost:8090
